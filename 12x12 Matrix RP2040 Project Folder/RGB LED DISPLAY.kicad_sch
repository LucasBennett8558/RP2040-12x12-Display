	(text "Will be excluded from design."
		(exclude_from_sim no)
		(at 195.58 466.344 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "997e8b81-de01-4f80-8736-467a9ccbeb23")
	)
	(text "VDD"
		(exclude_from_sim no)
		(at 75.946 129.54 0)
		(effects
			(font
				(size 12.7 12.7)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "9a964773-0a9d-4718-a364-3aa555f998c0")
	)
	(text "A decoupling capacitor"
		(exclude_from_sim no)
		(at 229.362 490.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a4a26741-3e13-4efc-8764-3d82b91bdb1f")
	)
	(text "Each row has it's own seperate GPIO line; it gives me a little more framerate.\nAnd I won't really need that much external GPIO to just mess around with."
		(exclude_from_sim no)
		(at 194.818 532.384 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a58f3718-28cb-4576-9641-fdf8f6379c1f")
	)
	(text "REFERENCE ONLY\nSingle LED Cell"
		(exclude_from_sim no)
		(at 193.548 456.692 0)
		(effects
			(font
				(size 5.08 5.08)
			)
		)
		(uuid "b0d2c6ce-177f-47d0-9de1-cc2a4f4223b4")
	)
	(text "GND"
		(exclude_from_sim no)
		(at 779.272 127.254 0)
		(effects
			(font
				(size 12.7 12.7)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "c0073cc1-8189-41fe-a203-67c9d88a0c7e")
	)
	(text "Level-shifter"
		(exclude_from_sim no)
		(at 75.184 292.354 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "db58c2c1-d1c6-46f9-bf6a-c91134b9bca8")
	)
	(text "I've spent a significant amount of time working through the current draw, and I can guarantee that the power consumption will remain within the supply specification (less than 2.5 A).\n\nI removed the load-sharing circuitry because, realistically, USB will not provide enough power to operate the LEDs while also maintaining the required battery-charging limits.\n\nThe original load-sharing implementation was simply a Schottky diode and an NMOS. However, keeping that circuitry would require the microcontroller to disable the load initially \n\nand wait until the USB connection has negotiated a higher Power Delivery (PD) level. Otherwise, drawing close to 2 A immediately could cause the USB host/charger to detect an \n\novercurrent condition, disable VBUS, or fall back to a current limit of approximately 20 mA.\n\nTherefore, the current design relies on negotiating the appropriate USB PD level before allowing the full load to be enabled."
		(exclude_from_sim no)
		(at 624.84 566.42 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
				(color 194 194 194 1)
			)
		)
		(uuid "efea1f8b-5957-40d9-9440-baa7fff3ea8b")
	)
